SUPABASE_PROJECT_REF=ref
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321/
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=publishable_key

# Optional: shared 3dwork GitHub save so every browser opens the same bench.
# Create a private repo named 3dwork-bench, then:
# GITHUB_3DWORK_TOKEN=github_pat_...
# GITHUB_3DWORK_REPO=yourname/3dwork-bench

# Optional: Google OAuth Web client so 3dwork can list / preview STL and 3MF
# from Drive (Drive itself cannot preview those). Authorized JS origin must
# include the 3dwork URL. Users can also paste the client id in the Drive dialog.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=123.apps.googleusercontent.com
