SUPABASE_PROJECT_REF=ref
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321/
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=publishable_key

# 3dwork parts cloud is the company Supabase project (same as TurboPaint).
# GitHub on kjarni is the website code, not where meshes live.
# Optional leftover: a private 3dwork-bench repo as a GitHub backup.
# GITHUB_3DWORK_TOKEN=github_pat_...
# GITHUB_3DWORK_REPO=yourname/3dwork-bench

# 3dwork Drive: company Web OAuth client. Already baked into the app as a
# fallback. Authorized JS origins on this client must include the 3dwork URL.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=708215000553-77htigi4tkqdr00bfak0j2e539h9bc2d.apps.googleusercontent.com
